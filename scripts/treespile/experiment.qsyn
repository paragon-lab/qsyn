//!ARGS FHAM OUT T N DEVICE COST_FN OPTIMIZE_LEVEL EXHAUSTIVE_FLAG SEED_FLAG
// Treespile encoding experiment: JW ground truth + TT treespile circuit + Clifford C.
// Invoked by scripts/treespile/run_experiment.py
// OPTIMIZE_LEVEL: 0 / 1 / 2 (see fham treespile --optimize-level)
// EXHAUSTIVE_FLAG: pass "-e" or leave empty
// SEED_FLAG: pass "--seed <uint>" or leave empty for nondeterministic SA

device fetch -f ${DEVICE}
fham read ${FHAM}
fham qubitize -s jw
qbham write ${OUT}/H_jw.txt

fham read ${FHAM}
device fetch -f ${DEVICE}
// Treespile first so workspace encoding is the tree actually used for synthesis.
fham treespile ${T} ${N} --logical-index --cost-fn ${COST_FN} --optimize-level ${OPTIMIZE_LEVEL} ${EXHAUSTIVE_FLAG} ${SEED_FLAG}
// Re-qubitize with no -s/-o to match that encoding (do not rebuild or re-SA).
fham qubitize
qbham write ${OUT}/H_T.txt
qcir write ${OUT}/QC_T_untranspiled.qasm
qcir translate --qiskit
qcir write ${OUT}/QC_T.qasm
qcir print --esp --esp-gates-only
qcir print --proxy-fidelity --proxy-fidelity-gates-only

convert fham tableau --encoding
convert tableau qcir
qcir write ${OUT}/C.qasm

device write --ibmq ${OUT}/device.json
